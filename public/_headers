# Response headers for Cloudflare static assets (read by Workers Static Assets; not served).
#
# Everything under /assets/ is requested with ?v=<content hash>: scripts/stamp-assets.mjs writes it into
# index.html, so a changed file always gets a new URL and these can be cached for a year.
# index.html and data/ keep the default (revalidate on every visit).

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
